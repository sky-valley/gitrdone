# Example systemd EnvironmentFile for gitrdone-main-1.
# Copy to /etc/gitrdone/gitrdone.env and fill secret values from:
# Shared/gitrdone-main DigitalOcean deployment secrets

GITRDONE_ADDR=127.0.0.1:8080
GITRDONE_BASE_URL=https://grd.differ.run
GITRDONE_STORAGE_ROOT=/var/lib/gitrdone
GITRDONE_DATABASE_URL=<from-1password>
GITRDONE_CONTROL_BEARER=<from-1password>
GITRDONE_TRUSTED_PROXIES=127.0.0.1/32,::1/128
GITRDONE_SHUTDOWN_TIMEOUT=2m

# Sentry DSNs are public routing identifiers. Keep auth tokens in 1Password;
# keep this DSN here so main can be redeployed without rediscovering it.
SENTRY_DSN=https://a7d68c7c3711e1426d841348664398c0@o4511632351363072.ingest.us.sentry.io/4511632392585216
SENTRY_ENVIRONMENT=main
SENTRY_RELEASE=<deployed-git-sha>
SENTRY_TRACES_SAMPLE_RATE=0.05
