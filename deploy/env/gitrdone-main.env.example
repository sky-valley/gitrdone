# Example systemd EnvironmentFile for a gitrdone production deployment.
# Copy to /etc/gitrdone/gitrdone.env and fill secret values from your
# deployment secret manager.

GITRDONE_ADDR=127.0.0.1:8080
GITRDONE_BASE_URL=https://git.example.com
GITRDONE_STORAGE_ROOT=/var/lib/gitrdone
GITRDONE_MAX_LFS_OBJECT_BYTES=5368709120
GITRDONE_DATABASE_URL=<postgres-url>
GITRDONE_CONTROL_BEARER=<control-bearer-token>
GITRDONE_TRUSTED_PROXIES=127.0.0.1/32,::1/128
GITRDONE_SHUTDOWN_TIMEOUT=2m

SENTRY_DSN=<optional-sentry-dsn>
SENTRY_ENVIRONMENT=main
SENTRY_RELEASE=<deployed-git-sha>
SENTRY_TRACES_SAMPLE_RATE=0.05
